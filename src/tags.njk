---
pagination:
  data: collections
  size: 1
  alias: tag
  filter:
    - all
    - posts
    - tagList
layout: layouts/base.njk
eleventyComputed:
  title: "Tagged: {{ tag }}"
permalink: /tags/{{ tag | slugify }}/
---
<div class="section-label">/ Tagged: {{ tag }}</div>
<div class="post-grid">
  {% set tagPosts = collections[tag] | reverse %}
  {% for post in tagPosts %}
    {% include "partials/post-card.njk" %}
  {% endfor %}
</div>
