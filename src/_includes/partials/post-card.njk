<a href="{{ post.url }}" class="post-card">
  {% if post.data.image %}
  <div class="post-card-image">
    <img src="/posts/images/{{ post.data.image }}" alt="{{ post.data.title }}" loading="lazy">
  </div>
  {% endif %}
  <div class="post-card-body">
    <span class="post-card-date">{{ post.date | isoDate | replace("T00:00:00.000Z", "") }}</span>
    <h2 class="post-card-title">{{ post.data.title }} <span class="arrow">&#8599;</span></h2>
    {% if post.data.description %}<p>{{ post.data.description }}</p>{% endif %}
    {% if post.data.tags %}
    <div class="tag-list">
      {% for tag in post.data.tags %}
        {% if tag !== "posts" %}
        <span class="tag-pill">{{ tag }}</span>
        {% endif %}
      {% endfor %}
    </div>
    {% endif %}
  </div>
</a>
